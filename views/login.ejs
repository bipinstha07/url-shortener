<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - URL Shortener</title>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800;900&family=Share+Tech+Mono&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Share Tech Mono', monospace;
            background: #000;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #00ff41;
            line-height: 1.6;
            position: relative;
            overflow: hidden;
        }

        /* Matrix rain background */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(180deg, 
                rgba(0, 0, 0, 0.9) 0%, 
                rgba(0, 20, 0, 0.8) 50%, 
                rgba(0, 0, 0, 0.9) 100%);
            z-index: -2;
        }

        .matrix-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            opacity: 0.3;
        }

        .matrix-rain {
            position: absolute;
            color: #00ff41;
            font-family: 'Share Tech Mono', monospace;
            font-size: 14px;
            line-height: 14px;
            text-shadow: 0 0 5px #00ff41;
            animation: matrix-fall 3s linear infinite;
        }

        @keyframes matrix-fall {
            0% {
                transform: translateY(-100vh);
                opacity: 1;
            }
            100% {
                transform: translateY(100vh);
                opacity: 0;
            }
        }

        .container {
            width: 100%;
            max-width: 450px;
            padding: 2rem;
            position: relative;
            z-index: 10;
        }

        .card {
            background: rgba(0, 20, 0, 0.9);
            backdrop-filter: blur(10px);
            border-radius: 15px;
            box-shadow: 
                0 0 20px rgba(0, 255, 65, 0.3),
                inset 0 0 20px rgba(0, 255, 65, 0.1);
            padding: 3rem;
            border: 2px solid #00ff41;
            position: relative;
            transition: all 0.3s ease;
            animation: cardGlow 2s ease-in-out infinite alternate;
        }

        .card::before {
            content: '';
            position: absolute;
            top: -2px;
            left: -2px;
            right: -2px;
            bottom: -2px;
            background: linear-gradient(45deg, #00ff41, #00cc33, #00ff41);
            border-radius: 15px;
            z-index: -1;
            animation: borderGlow 3s ease-in-out infinite;
        }

        @keyframes cardGlow {
            0% {
                box-shadow: 
                    0 0 20px rgba(0, 255, 65, 0.3),
                    inset 0 0 20px rgba(0, 255, 65, 0.1);
            }
            100% {
                box-shadow: 
                    0 0 30px rgba(0, 255, 65, 0.5),
                    inset 0 0 30px rgba(0, 255, 65, 0.2);
            }
        }

        @keyframes borderGlow {
            0%, 100% {
                opacity: 1;
            }
            50% {
                opacity: 0.5;
            }
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 
                0 0 40px rgba(0, 255, 65, 0.6),
                inset 0 0 40px rgba(0, 255, 65, 0.3);
        }

        .header {
            text-align: center;
            margin-bottom: 2.5rem;
        }

        .logo {
            font-family: 'Orbitron', monospace;
            font-size: 2.5rem;
            font-weight: 800;
            color: #00ff41;
            text-shadow: 
                0 0 10px #00ff41,
                0 0 20px #00ff41,
                0 0 30px #00ff41;
            margin-bottom: 0.5rem;
            animation: textGlow 2s ease-in-out infinite alternate;
        }

        @keyframes textGlow {
            0% {
                text-shadow: 
                    0 0 10px #00ff41,
                    0 0 20px #00ff41;
            }
            100% {
                text-shadow: 
                    0 0 20px #00ff41,
                    0 0 30px #00ff41,
                    0 0 40px #00ff41;
            }
        }

        .subtitle {
            color: #00cc33;
            font-size: 1rem;
            font-weight: 400;
            text-shadow: 0 0 5px #00cc33;
        }

        .form-section {
            animation: slideUp 0.6s ease-out;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 600;
            color: #00ff41;
            font-size: 0.9rem;
            text-shadow: 0 0 5px #00ff41;
        }

        .form-input {
            width: 100%;
            padding: 1rem;
            border: 2px solid #00ff41;
            border-radius: 8px;
            font-size: 1rem;
            transition: all 0.3s ease;
            background: rgba(0, 20, 0, 0.8);
            color: #00ff41;
            font-family: 'Share Tech Mono', monospace;
            box-shadow: inset 0 0 10px rgba(0, 255, 65, 0.2);
        }

        .form-input:focus {
            outline: none;
            border-color: #00ff88;
            box-shadow: 
                0 0 15px rgba(0, 255, 65, 0.5),
                inset 0 0 15px rgba(0, 255, 65, 0.3);
            transform: translateY(-2px);
        }

        .form-input::placeholder {
            color: #00cc33;
            opacity: 0.7;
        }

        .submit-btn {
            width: 100%;
            padding: 1rem 2rem;
            background: linear-gradient(45deg, #00ff41, #00cc33);
            color: #000;
            border: none;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: 'Orbitron', monospace;
            position: relative;
            overflow: hidden;
            margin-top: 1rem;
            text-shadow: none;
            box-shadow: 
                0 0 20px rgba(0, 255, 65, 0.5),
                inset 0 0 20px rgba(0, 255, 65, 0.2);
        }

        .submit-btn:hover {
            transform: translateY(-3px);
            box-shadow: 
                0 0 30px rgba(0, 255, 65, 0.8),
                inset 0 0 30px rgba(0, 255, 65, 0.4);
            background: linear-gradient(45deg, #00ff88, #00ff41);
        }

        .submit-btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
            transition: left 0.5s;
        }

        .submit-btn:hover::before {
            left: 100%;
        }

        .divider {
            text-align: center;
            margin: 2rem 0;
            position: relative;
            color: #00cc33;
            font-size: 0.875rem;
        }

        .divider::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, #00ff41, transparent);
        }

        .divider span {
            background: rgba(0, 20, 0, 0.9);
            padding: 0 1rem;
            position: relative;
        }

        .signup-link {
            display: block;
            text-align: center;
            padding: 1rem 2rem;
            background: transparent;
            color: #00ff41;
            border: 2px solid #00ff41;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
            font-family: 'Orbitron', monospace;
            text-shadow: 0 0 5px #00ff41;
        }

        .signup-link:hover {
            background: #00ff41;
            color: #000;
            transform: translateY(-3px);
            box-shadow: 0 0 20px rgba(0, 255, 65, 0.6);
            text-shadow: none;
        }

        .features {
            margin-top: 2rem;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1rem;
        }

        .feature {
            text-align: center;
            padding: 1rem;
            background: rgba(0, 255, 65, 0.1);
            border-radius: 8px;
            border: 1px solid rgba(0, 255, 65, 0.3);
            transition: all 0.3s ease;
        }

        .feature:hover {
            background: rgba(0, 255, 65, 0.2);
            border-color: #00ff41;
            transform: translateY(-2px);
            box-shadow: 0 0 15px rgba(0, 255, 65, 0.3);
        }

        .feature-icon {
            font-size: 1.5rem;
            margin-bottom: 0.5rem;
            text-shadow: 0 0 10px #00ff41;
        }

        .feature-text {
            font-size: 0.75rem;
            color: #00cc33;
            font-weight: 500;
        }

        @media (max-width: 768px) {
            .container {
                padding: 1rem;
            }
            
            .card {
                padding: 2rem;
            }
            
            .logo {
                font-size: 2rem;
            }
            
            .features {
                grid-template-columns: 1fr;
                gap: 0.5rem;
            }
        }

        /* Animation classes */
        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(15px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Loading animation for button */
        .loading {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid rgba(0, 255, 65, 0.3);
            border-radius: 50%;
            border-top-color: #00ff41;
            animation: spin 1s ease-in-out infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        /* Focus visible for accessibility */
        .submit-btn:focus-visible,
        .form-input:focus-visible,
        .signup-link:focus-visible {
            outline: 2px solid #00ff41;
            outline-offset: 2px;
        }

        /* Matrix rain effect */
        .matrix-rain {
            position: absolute;
            color: #00ff41;
            font-family: 'Share Tech Mono', monospace;
            font-size: 14px;
            line-height: 14px;
            text-shadow: 0 0 5px #00ff41;
            animation: matrix-fall 3s linear infinite;
        }
    </style>
</head>
<body>
    <!-- Matrix rain background -->
    <div class="matrix-bg" id="matrixBg"></div>

    <div class="container">
        <div class="card">
            <div class="header">
                <h1 class="logo">🔗 URL SHORTENER</h1>
                <p class="subtitle">ACCESS THE MATRIX OF SHORTENED URLS</p>
            </div>

            <div class="form-section">
                <form action="/login" method="POST">
                    <div class="form-group">
                        <label for="name" class="form-label">USERNAME</label>
                        <input type="text" id="name" name="name" class="form-input" required 
                               placeholder="ENTER YOUR USERNAME">
                    </div>

                    <div class="form-group">
                        <label for="password" class="form-label">PASSWORD</label>
                        <input type="password" id="password" name="password" class="form-input" required 
                               placeholder="ENTER YOUR PASSWORD">
                    </div>

                    <button type="submit" class="submit-btn">
                        🔐 ACCESS SYSTEM
                    </button>
                </form>

                <div class="divider">
                    <span>OR</span>
                </div>

                <a href="/signup" class="signup-link">
                    ✨ CREATE NEW IDENTITY
                </a>
            </div>

            <div class="features">
                <div class="feature">
                    <div class="feature-icon">✂️</div>
                    <div class="feature-text">SHORTEN URLS</div>
                </div>
                <div class="feature">
                    <div class="feature-icon">📊</div>
                    <div class="feature-text">TRACK DATA</div>
                </div>
                <div class="feature">
                    <div class="feature-icon">🔒</div>
                    <div class="feature-text">SECURE</div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Matrix rain effect
        function createMatrixRain() {
            const matrixBg = document.getElementById('matrixBg');
            const characters = '01アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲン';
            
            for (let i = 0; i < 50; i++) {
                const rain = document.createElement('div');
                rain.className = 'matrix-rain';
                rain.style.left = Math.random() * 100 + '%';
                rain.style.animationDelay = Math.random() * 3 + 's';
                rain.style.animationDuration = (Math.random() * 2 + 2) + 's';
                
                let text = '';
                for (let j = 0; j < 20; j++) {
                    text += characters[Math.floor(Math.random() * characters.length)] + '<br>';
                }
                rain.innerHTML = text;
                
                matrixBg.appendChild(rain);
            }
        }

        // Initialize matrix rain
        createMatrixRain();

        // Add loading state to form
        document.querySelector('form').addEventListener('submit', function() {
            const submitBtn = this.querySelector('.submit-btn');
            const originalText = submitBtn.textContent;
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="loading"></span> ACCESSING...';
            
            // Re-enable after timeout (in case of errors)
            setTimeout(() => {
                submitBtn.disabled = false;
                submitBtn.textContent = originalText;
            }, 10000);
        });

        // Add focus effects
        document.querySelectorAll('.form-input').forEach(input => {
            input.addEventListener('focus', function() {
                this.parentNode.classList.add('focused');
            });
            
            input.addEventListener('blur', function() {
                if (!this.value) {
                    this.parentNode.classList.remove('focused');
                }
            });
        });

        // Add glitch effect to logo
        setInterval(() => {
            const logo = document.querySelector('.logo');
            if (Math.random() < 0.1) {
                logo.style.textShadow = '0 0 20px #ff0000, 0 0 30px #ff0000';
                setTimeout(() => {
                    logo.style.textShadow = '';
                }, 100);
            }
        }, 2000);
    </script>
</body>
</html>
